# Required for live Phase 2 extraction. Never commit a real key.
# Gemini free-tier content may be used by Google to improve its products.
# This project sends synthetic documents only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Local defaults used by Docker Compose
DATABASE_PATH=/app/data/jeevansetu.db
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
